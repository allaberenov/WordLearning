APP_IMAGE=ghcr.io/your-owner/your-repo:latest
APP_BIND=0.0.0.0
APP_PORT=3000
RUN_MIGRATIONS=true

POSTGRES_DB=word_learning
POSTGRES_USER=word_learning
POSTGRES_PASSWORD=change-this-postgres-password

AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-new-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_SENTENCE_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=20000

GENERATION_RATE_LIMIT_RPM=60
GENERATION_RATE_LIMIT_RPD=1000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional, only when using docker-compose.caddy.yml
DOMAIN=example.com
