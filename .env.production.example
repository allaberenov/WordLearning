APP_IMAGE=ghcr.io/your-owner/your-repo:latest
APP_BIND=0.0.0.0
APP_PORT=3000
RUN_MIGRATIONS=true

POSTGRES_DB=word_learning
POSTGRES_USER=word_learning
POSTGRES_PASSWORD=change-this-postgres-password

AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
ADMIN_EMAILS=

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-new-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_SENTENCE_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=20000
GROQ_MAX_CONCURRENCY=1
GROQ_QUEUE_MAX_SIZE=20
GROQ_QUEUE_TIMEOUT_MS=15000
GROQ_GLOBAL_RPM=25
GROQ_GLOBAL_RPD=900

GENERATION_RATE_LIMIT_RPM=5
GENERATION_RATE_LIMIT_RPD=200

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional, only when using docker-compose.caddy.yml
DOMAIN=example.com
