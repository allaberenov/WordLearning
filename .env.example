DATABASE_URL="postgresql://postgres:postgres@localhost:5432/word_learning?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"

# Use "gemini", "ollama", or "openai".
AI_PROVIDER="gemini"

# Gemini generation. Required when AI_PROVIDER="gemini".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TIMEOUT_MS="30000"

# Ollama local generation.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
OLLAMA_TIMEOUT_MS="60000"

# OpenAI generation. Required only when AI_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
