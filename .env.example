DATABASE_URL="postgresql://postgres:postgres@localhost:5432/word_learning?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"

# Use "gemini", "groq", "ollama", or "openai".
AI_PROVIDER="gemini"

# Gemini generation. Required when AI_PROVIDER="gemini".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TIMEOUT_MS="30000"

# Ollama local generation.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
OLLAMA_TIMEOUT_MS="60000"

# Groq generation. Required when AI_PROVIDER="groq".
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.6-27b"
GROQ_SENTENCE_MODEL="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_TIMEOUT_MS="20000"
GROQ_MAX_CONCURRENCY="1"
GROQ_QUEUE_MAX_SIZE="20"
GROQ_QUEUE_TIMEOUT_MS="15000"
GROQ_GLOBAL_RPM="25"
GROQ_GLOBAL_RPD="900"

# App-side generation throttling.
GENERATION_RATE_LIMIT_RPM="5"
GENERATION_RATE_LIMIT_RPD="200"

# OpenAI generation. Required only when AI_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
